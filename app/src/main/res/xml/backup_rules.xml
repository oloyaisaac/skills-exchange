<?xml version="1.0" encoding="utf-8"?><!--
  REM-016: cloud backup is disabled (android:allowBackup="false"). These exclusions are kept as
  defence in depth for any tooling/OS path that still inspects the rules: no database, preference
  (Firebase Auth tokens and DataStore live here), file or cache content may leave the device.
  Device-to-device transfer is excluded in data_extraction_rules.xml as well.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
