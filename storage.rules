rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Helper function for job photo participant authorization on stored objects
    function isJobParticipantOnStoredObject() {
      return resource.metadata != null && (
        ('jobOwnerId' in resource.metadata && resource.metadata.jobOwnerId == request.auth.uid) ||
        ('assignedProviderId' in resource.metadata && resource.metadata.assignedProviderId == request.auth.uid)
      );
    }

    // Helper function for job photo participant authorization on incoming writes
    function isJobParticipantOnIncomingWrite() {
      return request.resource.metadata != null && (
        ('jobOwnerId' in request.resource.metadata && request.resource.metadata.jobOwnerId == request.auth.uid) ||
        ('assignedProviderId' in request.resource.metadata && request.resource.metadata.assignedProviderId == request.auth.uid)
      );
    }

    // --- SEC-003: PRIVATE KYC & IDENTITY DOCUMENT STORAGE ---
    // Strict isolation: National IDs, guarantor documents, selfie verifications, and qualification certificates
    // are accessible ONLY by the document owner and authorized administrators.
    match /users/{userId}/kyc/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/guarantors/{allPaths=**} {
      // REG-002: third-party NIN images and verification photographs stay private —
      // owner and admins only, with no public read and no signed URLs issued to clients.
      // Uploads are constrained to reasonable image sizes; reviewers fetch them through
      // the admin-only Cloud Function.
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() || (
        isOwner(userId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
      );
    }

    match /users/{userId}/certificates/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/verification/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Private documents bucket prefix
    match /private_docs/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- SEC-008: JOB BEFORE/AFTER PHOTOS & RECEIPTS ---
    // SEC-008: Restrict job photo access to job owner, assigned provider, and admin.
    // Stored and incoming files must include custom metadata: jobOwnerId and assignedProviderId.
    // Reads use stored resource metadata; writes validate incoming request metadata.
    match /jobs/{jobId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isJobParticipantOnStoredObject()
      );
      allow create, update: if isAuthenticated() && (
        isAdmin() || (
          isJobParticipantOnIncomingWrite()
          && request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        )
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isJobParticipantOnStoredObject()
      );
    }

    // --- PUBLIC ASSETS & AVATARS ---
    // Public assets (app icons, branding): publicly readable, but write operations are restricted
    // to administrators to prevent arbitrary public file hosting or asset tampering.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || (
        isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
      );
    }
  }
}
